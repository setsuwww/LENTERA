
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Book {
  id        String   @id @default(cuid())
  title     String
  author    String
  isbn      String   @unique
  category  String
  publisher String
  year      Int
  stock     Int      @default(0)
  borrowed  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([title])
  @@index([author])
  @@index([category])
}

model Member {
  id            String   @id @default(cuid())
  studentId     String   @unique
  name          String
  email         String   @unique
  passwordHash  String?
  phone         String?
  department    String
  studyProgram  String
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions Transaction[]

  @@index([name])
  @@index([department])
  @@index([status])
}


model Transaction {
  id         String   @id @default(cuid())
  memberId   String
  bookId     String
  quantity   Int      @default(1)
  borrowDate DateTime @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String   @default("Borrowed")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([memberId])
  @@index([bookId])
  @@index([status])
  @@index([dueDate])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}
